# Heatmap generation and saving
data = merged_df.copy() # Make sure fo_perf is defined earlier

# heatmap with conditional formatting
num_rows = data.shape[0]
fig_height = max(8, num_rows * 0.5)
fig, ax = plt.subplots(figsize=(12, fig_height))

# Create a matrix to hold the color values - fill with NaN initially
color_matrix = pd.DataFrame(np.nan, index=data.index, columns=data.columns)

# Define which columns need conditional formatting
active_return_cols = [('Daily', 'Active %'), ('WTD', 'Active %'), ('MTD', 'Active %'), 
                     ('QTD', 'Active %'), ('YTD', 'Active %'), ('1 year', 'Active %')]
active_risk_col = [('Active', 'Risk')]

# Get all Active % values across all Active % columns for consistent scaling
all_active_return_values = []
for col in active_return_cols:
    if col in data.columns:
        all_active_return_values.extend(data[col].dropna().values)

# Calculate min and max across ALL Active % columns
if len(all_active_return_values) > 0:
    active_return_min = min(all_active_return_values)
    active_return_max = max(all_active_return_values)
    
    # Apply consistent scaling to all Active % columns
    for col in active_return_cols:
        if col in data.columns:
            if active_return_max != active_return_min:
                color_matrix[col] = (data[col] - active_return_min) / (active_return_max - active_return_min)
            else:
                color_matrix[col] = 0.5

# For Active Risk - scale within its own column (lower risk = green)
for col in active_risk_col:
    if col in data.columns:
        col_data = data[col].dropna()
        if len(col_data) > 0 and col_data.max() != col_data.min():
            # Invert and normalize
            min_val = col_data.min()
            max_val = col_data.max()
            color_matrix[col] = 1 - (data[col] - min_val) / (max_val - min_val)
        else:
            color_matrix[col] = 0.5

# Leave all other columns (Port %, Portfolio Risk, Active Beta) as NaN - they will appear white

annot_matrix = data.copy()
annot_matrix = annot_matrix.round(2).astype(str)
annot_matrix = annot_matrix.replace('nan', '')

# Create Excel-style colormap (red -> yellow -> green)
colors = ['#F8696B', '#FFEB84', '#63BE7B']  # Red -> Yellow -> Green
n_bins = 100
cmap = LinearSegmentedColormap.from_list('excel_style', colors, N=n_bins)

# Create a custom colormap that handles NaN as white
cmap.set_bad(color='white')

# Plot the heatmap
sns.heatmap(color_matrix, annot=annot_matrix, fmt='', cmap=cmap, 
            vmin=0, vmax=1, cbar=False, ax=ax)

# Remove default x-axis tick labels
ax.set_xticklabels([])

# Add second-level labels (Metric: Port %, Active %)
metric_labels = [col[1] for col in data.columns]
ax.set_xticks([i + 0.5 for i in range(len(data.columns))])
ax.set_xticklabels(metric_labels, rotation=0, ha='center', fontsize=10)

# Add first-level labels (Period: Daily, Weekly...) using a second row of ticks
period_labels = [col[0] for col in data.columns]
unique_periods = []
positions = []
for i, label in enumerate(period_labels):
    if i == 0 or label != period_labels[i - 1]:
        unique_periods.append(label)
        positions.append(i + 0.5 + (period_labels[i + 1:].count(label) - 1) / 2)

for pos, label in zip(positions, unique_periods):
    ax.text(pos, 0.7, label, ha='center', va='bottom', fontsize=10)

ax.xaxis.tick_top()
ax.tick_params(axis='x', which='both', bottom=False, top=True)
plt.xlabel("")
plt.tight_layout()

# Save the figure
heatmap_path = "heatmap_output.png"
plt.savefig(heatmap_path, dpi=300, bbox_inches='tight') # High quality
plt.show()
