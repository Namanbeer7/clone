from io import BytesIO
import xlsxwriter

def create_client_level_excel(client_data_dict):
    """
    Create Excel file with client-level chart data
    """
    output = BytesIO()
    
    with pd.ExcelWriter(output, engine='xlsxwriter') as writer:
        # Write each dataset to a separate sheet
        for sheet_name, df in client_data_dict.items():
            df.to_excel(writer, sheet_name=sheet_name, index=False)
        
        # Get workbook and add formats
        workbook = writer.book
        header_format = workbook.add_format({
            'bold': True,
            'bg_color': '#D7E4BD',
            'border': 1
        })
        
        # Format headers for each sheet
        for sheet_name in client_data_dict.keys():
            worksheet = writer.sheets[sheet_name]
            worksheet.set_column('A:Z', 15)  # Set column width
    
    output.seek(0)
    return output


def create_fund_level_excel(fund_data_dict, fund_name):
    """
    Create Excel file with fund-level chart data
    """
    output = BytesIO()
    
    with pd.ExcelWriter(output, engine='xlsxwriter') as writer:
        # Write each dataset to a separate sheet
        for sheet_name, df in fund_data_dict.items():
            df.to_excel(writer, sheet_name=sheet_name, index=False)
        
        # Get workbook and add formats
        workbook = writer.book
        header_format = workbook.add_format({
            'bold': True,
            'bg_color': '#D7E4BD',
            'border': 1
        })
        
        # Add a summary sheet with fund name
        summary_df = pd.DataFrame({'Fund Name': [fund_name], 'Export Date': [datetime.now().strftime('%Y-%m-%d')]})
        summary_df.to_excel(writer, sheet_name='Summary', index=False)
        
        # Format headers for each sheet
        for sheet_name in fund_data_dict.keys():
            if sheet_name in writer.sheets:
                worksheet = writer.sheets[sheet_name]
                worksheet.set_column('A:Z', 15)  # Set column width
    
    output.seek(0)
    return output


