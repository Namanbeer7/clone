def generate_excel_for_plots(
    forecast_type: str,
    T_periods: int,
    agg_ill_targetnav_array: np.ndarray,
    current_total_nav_existing: float,
    indv_target_weights_dict: dict,
    V_df_full: pd.DataFrame,
    C_df_full: pd.DataFrame,
    D_df_full: pd.DataFrame,
    liqlims_array: np.ndarray,
    commitment_plan_df: pd.DataFrame = None,
    indv_ill_weights: np.ndarray = None,
    # Add parameters for documentation
    input_parameters: dict = None
) -> bytes:
    """
    Generate Excel data for both forecast types with input parameters documentation.
    """
    import io
    
    excel_data_dict = {}
    
    # 1. Add Input Parameters as first sheet
    if input_parameters:
        params_data = pd.DataFrame([
            {'Parameter': key, 'Value': value} 
            for key, value in input_parameters.items()
        ])
        excel_data_dict["Input_Parameters"] = params_data
    
    # 2. Target Allocations Summary
    target_alloc_summary = pd.DataFrame({
        'Asset Class': list(indv_target_weights_dict.keys()),
        'Target Weight': [f"{w:.1%}" for w in indv_target_weights_dict.values()],
        'Target Weight (Decimal)': list(indv_target_weights_dict.values())
    })
    excel_data_dict["Target_Allocations"] = target_alloc_summary
    
    # Rest of your existing code for other sheets...
    # (Include all the previous sheet generation code here)
    
    # 3-7. [Previous sheets as before]
    
    # For Commitment Optimization, add optimization constraints
    if forecast_type == "Commitment Optimization" and input_parameters:
        if all(k in input_parameters for k in ['Min Commit', 'Max Commit', 'Min Non-Zero Commit']):
            constraints_data = []
            for asset_class in indv_target_weights_dict.keys():
                constraints_data.append({
                    'Asset Class': asset_class,
                    'Min Commit ($M)': input_parameters.get('Min Commit', 0),
                    'Max Commit ($M)': input_parameters.get('Max Commit', 50),
                    'Min Non-Zero Commit ($M)': input_parameters.get('Min Non-Zero Commit', 1)
                })
            excel_data_dict["Commitment_Constraints"] = pd.DataFrame(constraints_data)
    
    # Create Excel file
    output = io.BytesIO()
    with pd.ExcelWriter(output, engine='xlsxwriter') as writer:
        for sheet_name, df in excel_data_dict.items():
            df.to_excel(writer, sheet_name=sheet_name, index=False)
            
            # Auto-adjust column widths for better readability
            worksheet = writer.sheets[sheet_name]
            for idx, col in enumerate(df.columns):
                max_length = max(
                    df[col].astype(str).map(len).max(),
                    len(str(col))
                ) + 2
                worksheet.set_column(idx, idx, max_length)
    
    output.seek(0)
    return output.getvalue()


# Updated integration function
def add_excel_download_section(forecast_type, **kwargs):
    """
    Add Excel download button with parameter documentation
    """
    st.sidebar.markdown("---")
    st.sidebar.subheader("📊 Download Chart Data")
    
    if st.sidebar.button("Prepare Excel Data", key=f"prep_excel_{forecast_type}"):
        try:
            # Build input parameters dictionary
            input_params = {
                'Client': kwargs.get('selected_client', 'Unknown'),
                'Forecast Type': forecast_type,
                'Time Frame (years)': kwargs.get('T', 'N/A'),
                'NAV Growth Rate': f"{kwargs.get('nav_growth_rate', 0) * 100:.1f}%",
                'Total Portfolio NAV ($M)': kwargs.get('total_port_nav', 'N/A'),
                'Privates Target': f"{kwargs.get('ill_target', 0) * 100:.1f}%",
                'Granularity': kwargs.get('granularity', 'N/A')
            }
            
            # Add optimization-specific parameters
            if forecast_type == "Commitment Optimization":
                input_params.update({
                    'Target Delay (years)': kwargs.get('target_delay', 0),
                    'Gamma': kwargs.get('gamma', 0.5),
                    'Smoothing Weight': kwargs.get('smoothing_weight', 5),
                    'Min Non-Zero Commit ($M)': kwargs.get('min_non_zero_commit', 1),
                    'Min Commit ($M)': kwargs.get('min_commit', 0),
                    'Max Commit ($M)': kwargs.get('max_commit', 50),
                    'Liquidity Limit ($M)': kwargs.get('liquidity_limit', 'N/A')
                })
            
            # Prepare parameters for Excel generation
            excel_params = {
                'forecast_type': forecast_type,
                'T_periods': int(kwargs['T']),
                'agg_ill_targetnav_array': kwargs['agg_ill_targetnav'],
                'current_total_nav_existing': kwargs.get('current_total_nav_existing', 
                                                         kwargs['existing_portfolio']['current_nav'].sum()),
                'indv_target_weights_dict': kwargs['indv_weights'],
                'V_df_full': kwargs['V_df'],
                'C_df_full': kwargs['C_df'],
                'D_df_full': kwargs['D_df'],
                'liqlims_array': kwargs['liqlims'],
                'input_parameters': input_params
            }
            
            # Add commitment-specific data if available
            if forecast_type == "Commitment Optimization":
                if 'commitment_plan_df' in kwargs:
                    excel_params['commitment_plan_df'] = kwargs['commitment_plan_df']
                if 'indv_ill_weights' in kwargs:
                    excel_params['indv_ill_weights'] = kwargs['indv_ill_weights']
            
            # Generate Excel
            excel_bytes = generate_excel_for_plots(**excel_params)
            
            # Create download button
            file_name = f"{kwargs.get('selected_client', 'Client')}_{forecast_type.replace(' ', '_').replace('+', 'and')}_data_{datetime.now().strftime('%Y%m%d_%H%M%S')}.xlsx"
            
            st.sidebar.download_button(
                label="📥 Download Excel File",
                data=excel_bytes,
                file_name=file_name,
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                key=f"download_excel_{forecast_type}"
            )
            st.sidebar.success("✅ Excel data ready for download!")
            
        except Exception as e:
            st.sidebar.error(f"❌ Error preparing Excel data: {str(e)}")
            with st.sidebar.expander("See error details"):
                import traceback
                st.code(traceback.format_exc())
