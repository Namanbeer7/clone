def get_irr(cusip, ticker, thedate, df_cashflows, df_trade):
    # Create subset NAV dataframe which excludes ASETIN/OUT and VALADI trantypes and zeros
    # in on the client and fund cusip in focus
    df_irr = df_cashflows.loc[((df_cashflows.commit_cusip.isin(cusip))\
                              & (df_cashflows.parent.isin(ticker))),\
                             ('trade_date', 'curr_face')].groupby(['trade_date'])['curr_face'].sum().reset_index()

    if df_irr.empty:
        return 0
    else:
        
        # Calculate the NAV for the date in scope
        thenav = df_trade[(df_trade.parent.isin(ticker)) & (df_trade.commit_cusip.isin(cusip)) & (df_trade.settle_date<=thedate)]['curr_face'].sum()
        
        if thenav == 0:
            return 0
        else:
            # Add another row which captures the ending NAV of the fund and the date in scope
            df_irr.loc[-1] = [thedate, thenav]
            
            # Create date and amount datasets to feed into xirr function
            datelist = df_irr.iloc[:, 0]
            amtlist = df_irr.iloc[:, 1]
            
            # Calculate and return IRR
            try:
                irr = xirr(datelist, amtlist)
                if irr is None:
                    return 0
                return irr
            except InvalidPaymentsError:
                print("InvalidPaymentsError: Ensure both negative and positive payments are present.", cusip, ticker)
                return 0

def create_client_level_excel(client_data_dict):
    """
    Create Excel file with client-level chart data
    """
    output = BytesIO()
    
    with pd.ExcelWriter(output, engine='xlsxwriter') as writer:
        # Write each dataset to a separate sheet
        for sheet_name, df in client_data_dict.items():
            df.to_excel(writer, sheet_name=sheet_name, index=False)
        
        # Get workbook and add formats
        workbook = writer.book
        header_format = workbook.add_format({
            'bold': True,
            'bg_color': '#D7E4BD',
            'border': 1
        })
        
        # Format headers for each sheet
        for sheet_name in client_data_dict.keys():
            worksheet = writer.sheets[sheet_name]
            worksheet.set_column('A:Z', 15)  # Set column width
    
    output.seek(0)
    return output


def create_fund_level_excel(fund_data_dict, fund_name):
    """
    Create Excel file with fund-level chart data
    """
    output = BytesIO()
    
    with pd.ExcelWriter(output, engine='xlsxwriter') as writer:
        # Write each dataset to a separate sheet
        for sheet_name, df in fund_data_dict.items():
            df.to_excel(writer, sheet_name=sheet_name, index=False)
        
        # Get workbook and add formats
        workbook = writer.book
        header_format = workbook.add_format({
            'bold': True,
            'bg_color': '#D7E4BD',
            'border': 1
        })
        
        # Add a summary sheet with fund name
        summary_df = pd.DataFrame({'Fund Name': [fund_name], 'Export Date': [datetime.now().strftime('%Y-%m-%d')]})
        summary_df.to_excel(writer, sheet_name='Summary', index=False)
        
        # Format headers for each sheet
        for sheet_name in fund_data_dict.keys():
            if sheet_name in writer.sheets:
                worksheet = writer.sheets[sheet_name]
                worksheet.set_column('A:Z', 15)  # Set column width
    
    output.seek(0)
    return output

