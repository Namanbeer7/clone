data = merged_df.copy()

# heatmap with conditional formatting
num_rows = data.shape[0]
fig_height = max(8, num_rows * 0.5)
fig, ax = plt.subplots(figsize=(12, fig_height))

# Create a matrix to hold the color values
color_matrix = pd.DataFrame(index=data.index, columns=data.columns, dtype=float)

# Define all column types
active_return_cols = [('Daily', 'Active %'), ('WTD', 'Active %'), ('MTD', 'Active %'), 
                     ('QTD', 'Active %'), ('YTD', 'Active %'), ('1 year', 'Active %')]
active_risk_col = [('Active', 'Risk')]
port_return_cols = [('Daily', 'Port %'), ('WTD', 'Port %'), ('MTD', 'Port %'), 
                    ('QTD', 'Port %'), ('YTD', 'Port %'), ('1 year', 'Port %')]
portfolio_risk_col = [('Portfolio', 'Risk')]
active_beta_col = [('Active', 'Beta')]

# Apply column-by-column conditional formatting
for col in data.columns:
    if col in active_return_cols:
        # For Active returns - use actual values for the colormap
        color_matrix[col] = data[col]
                
    elif col in active_risk_col:
        # For Active Risk - use actual values (higher risk = red, lower risk = green)
        color_matrix[col] = data[col]
                
    elif col in port_return_cols or col in portfolio_risk_col or col in active_beta_col:
        # For non-formatted columns - set to NaN
        color_matrix[col] = np.nan
    else:
        color_matrix[col] = np.nan

annot_matrix = data.copy()
annot_matrix = annot_matrix.round(2).astype(str)
annot_matrix = annot_matrix.replace('nan', '')

# Create the diverging colormap (red -> yellow -> green)
cmap = sns.diverging_palette(10, 145, s=90, l=55, sep=20, as_cmap=True)
cmap.set_bad(color='white')  # Set NaN to white

# For each formatted column, determine its own vmin/vmax centered at 0
fig, ax = plt.subplots(figsize=(12, fig_height))

# We'll need to plot each column separately with its own scale
for i, col in enumerate(data.columns):
    if col in active_return_cols or col in active_risk_col:
        # Get the data for this column
        col_data = data[col].dropna()
        if len(col_data) > 0:
            # Find the max absolute value for symmetric scaling around 0
            max_abs = max(abs(col_data.min()), abs(col_data.max()))
            vmin_col = -max_abs
            vmax_col = max_abs
        else:
            vmin_col = -1
            vmax_col = 1
    else:
        vmin_col = -1
        vmax_col = 1
    
    # Plot this single column
    single_col_color = color_matrix[[col]]
    single_col_annot = annot_matrix[[col]]
    
    if i == 0:
        # First column - create the base heatmap
        sns.heatmap(single_col_color, annot=single_col_annot, fmt='', cmap=cmap,
                    center=0, vmin=vmin_col, vmax=vmax_col, cbar=False, ax=ax,
                    xticklabels=False, yticklabels=(i == 0))
    else:
        # Subsequent columns - add to existing heatmap
        sns.heatmap(single_col_color, annot=single_col_annot, fmt='', cmap=cmap,
                    center=0, vmin=vmin_col, vmax=vmax_col, cbar=False, ax=ax,
                    xticklabels=False, yticklabels=False)
