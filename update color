portfolio_to_group = {}
group_colors = {}
custom_order = []

for group_name, group_info in portfolio_groups.items():
    group_colors[group_name] = group_info.get('color', '#E0E0E0')
    
    # Simple structure only - no nested groups
    for portfolio in group_info.get('portfolios', []):
        portfolio_to_group[portfolio] = group_name
        custom_order.append(portfolio)

# Filter to only include portfolios that exist in your data
existing_portfolios = [p for p in custom_order if p in merged_df.index]

if not existing_portfolios:
    print("Warning: No portfolios from custom_order found. Using all portfolios.")
    existing_portfolios = merged_df.index.tolist()
    for p in existing_portfolios:
        if p not in portfolio_to_group:
            portfolio_to_group[p] = 'Ungrouped'
            if 'Ungrouped' not in group_colors:
                group_colors['Ungrouped'] = '#F0F0F0'

# Create the reordered dataframe
data = merged_df.loc[existing_portfolios].copy()

# Calculate figure dimensions
num_rows = data.shape[0]
fig_height = max(10, num_rows * 0.4)

# Create figure with extra space for group labels
fig = plt.figure(figsize=(16, fig_height))

# Create axes: main heatmap and group column
ax_main = plt.axes([0.25, 0.1, 0.65, 0.8])  # Main heatmap
ax_groups = plt.axes([0.15, 0.1, 0.08, 0.8])  # Group labels

# Create color matrix for main heatmap
color_matrix = pd.DataFrame(index=data.index, columns=data.columns, dtype=float)

# Identify column types
active_return_cols = []
port_return_cols = []
active_risk_cols = []
portfolio_risk_cols = []
active_beta_cols = []

for col in data.columns:
    if isinstance(col, tuple) and len(col) >= 2:
        period, metric = col[0], col[1]
        if metric == 'Active %':
            active_return_cols.append(col)
        elif metric == 'Port %':
            port_return_cols.append(col)
        elif 'risk' in metric.lower() and 'active' in metric.lower():
            active_risk_cols.append(col)
        elif 'risk' in metric.lower() and 'portfolio' in metric.lower():
            portfolio_risk_cols.append(col)
        elif 'beta' in metric.lower():
            active_beta_cols.append(col)

# Define colormap
cmap_diverging = sns.diverging_palette(10, 145, s=90, l=55, sep=20, as_cmap=True)
cmap_diverging.set_bad(color='white')

# Apply conditional formatting
for col in data.columns:
    col_data = data[col].dropna()
    
    if len(col_data) > 0:
        if col in active_return_cols:
            vmax_abs = col_data.abs().max()
            if vmax_abs > 0:
                norm = TwoSlopeNorm(vmin=-vmax_abs, vcenter=0, vmax=vmax_abs)
                color_matrix[col] = col_data.apply(lambda x: norm(x) if pd.notna(x) else np.nan)
            else:
                color_matrix[col] = 0.5
        elif col in active_risk_cols:
            vmax_abs = col_data.abs().max()
            if vmax_abs > 0:
                norm = TwoSlopeNorm(vmin=-vmax_abs, vcenter=0, vmax=vmax_abs)
                color_matrix[col] = col_data.apply(lambda x: 1 - norm(x) if pd.notna(x) else np.nan)
            else:
                color_matrix[col] = 0.5
        elif col in port_return_cols or col in portfolio_risk_cols or col in active_beta_cols:
            color_matrix[col] = 0.5
        else:
            color_matrix[col] = 0.5
    else:
        color_matrix[col] = np.nan

# Prepare annotation matrix
annot_matrix = data.copy()
for col in annot_matrix.columns:
    annot_matrix[col] = annot_matrix[col].apply(lambda x: f'{x:.2f}' if pd.notna(x) else '')

# Plot main heatmap
sns.heatmap(color_matrix, annot=annot_matrix, fmt='', cmap=cmap_diverging,
            vmin=0, vmax=1, cbar=False, ax=ax_main, 
            linewidths=0.5, linecolor='lightgray')

# Setup axes for group column
ax_groups.set_xlim(0, 1)
ax_groups.set_ylim(0, len(data))
ax_groups.invert_yaxis()
ax_groups.set_xticks([])
ax_groups.set_yticks([])
for spine in ax_groups.spines.values():
    spine.set_visible(False)

# Track positions for drawing
current_pos = 0
group_boundaries = []

# Process each group
for group_name in portfolio_groups.keys():
    group_info = portfolio_groups[group_name]
    color = group_colors.get(group_name, '#E0E0E0')
    
    # Get all portfolios in this group that exist in data
    group_portfolios = [p for p in group_info.get('portfolios', []) 
                       if p in existing_portfolios]
    
    if group_portfolios:
        group_size = len(group_portfolios)
        
        # Draw group rectangle and label
        rect = FancyBboxPatch((0, current_pos), 1, group_size,
                              boxstyle="round,pad=0.02",
                              facecolor=color, edgecolor='black',
                              linewidth=1.5, alpha=0.8)
        ax_groups.add_patch(rect)
        
        # Add group label
        if group_size > 1:
            # For multi-row groups, add vertical text
            ax_groups.text(0.5, current_pos + group_size/2, group_name,
                          ha='center', va='center', rotation=90,
                          fontsize=11, fontweight='bold', color='white')
        else:
            # For single-row groups, horizontal text
            ax_groups.text(0.5, current_pos + 0.5, group_name,
                          ha='center', va='center', rotation=0,
                          fontsize=10, fontweight='bold', color='white')
        
        group_boundaries.append(current_pos + group_size)
        current_pos += group_size

# Add separation lines in main heatmap
for boundary in group_boundaries[:-1]:
    ax_main.axhline(y=boundary, color='black', linewidth=2, alpha=0.7)

# Customize main heatmap y-axis labels
ax_main.set_yticklabels(ax_main.get_yticklabels(), rotation=0, fontsize=9)

# Handle column labels
if isinstance(data.columns, pd.MultiIndex):
    ax_main.set_xticklabels([])
    
    periods = [col[0] for col in data.columns]
    metrics = [col[1] for col in data.columns]
    
    # Add metric labels
    ax_main.set_xticks([i + 0.5 for i in range(len(data.columns))])
    ax_main.set_xticklabels(metrics, rotation=0, ha='center', fontsize=9)
    
    # Add period labels
    current_period = None
    period_starts = []
    period_labels = []
    
    for i, period in enumerate(periods):
        if period != current_period:
            period_starts.append(i)
            period_labels.append(period)
            current_period = period
    
    for i, (start, label) in enumerate(zip(period_starts, period_labels)):
        if i < len(period_starts) - 1:
            end = period_starts[i + 1]
        else:
            end = len(periods)
        
        center = start + (end - start) / 2
        ax_main.text(center, -0.8, label, ha='center', va='bottom',
                    fontsize=10, fontweight='bold', transform=ax_main.transData)
        
        if i < len(period_starts) - 1:
            ax_main.axvline(x=end, color='gray', linewidth=1.5, alpha=0.5)

# Position x-axis labels at top
ax_main.xaxis.tick_top()
ax_main.xaxis.set_label_position('top')

# Add titles
fig.suptitle('Portfolio Performance Heatmap', fontsize=16, fontweight='bold', y=0.95)
ax_groups.set_title('Portfolio Groups', fontsize=12, fontweight='bold', pad=10)

# Add borders
for spine in ax_main.spines.values():
    spine.set_visible(True)
    spine.set_linewidth(2)
    spine.set_edgecolor('black')

# Clean up labels
ax_main.set_xlabel('')
ax_main.set_ylabel('')

# Save figure
heatmap_path = "grouped_portfolio_heatmap.png"
plt.savefig(heatmap_path, dpi=300, bbox_inches='tight', facecolor='white')
plt.show()
