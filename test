def ensure_combo_chart_types(chart, chart_name_for_logging):
    """
    Ensures correct chart types for combo charts after data update
    This is more robust than XML merging
    """
    if chart_name_for_logging != "NAV Forecast (Absolute NAV & Target Line)":
        return
    
    try:
        from pptx.oxml.ns import qn
        
        # Access the chart's XML
        chart_element = chart._element
        plot_area = chart_element.find('.//c:plotArea', 
                                      namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'})
        
        if plot_area is None:
            return
        
        # Find all series elements to identify which should be line vs area
        all_series = list(chart_element.findall('.//c:ser', 
                                               namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'}))
        
        # Identify Target NAV series
        target_nav_indices = []
        for idx, ser in enumerate(all_series):
            tx_elem = ser.find('.//c:tx', namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'})
            if tx_elem is not None:
                str_ref = tx_elem.find('.//c:strRef', namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'})
                if str_ref is not None:
                    str_cache = str_ref.find('.//c:strCache', namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'})
                    if str_cache is not None:
                        pt_elem = str_cache.find('.//c:pt', namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'})
                        if pt_elem is not None:
                            v_elem = pt_elem.find('.//c:v', namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'})
                            if v_elem is not None and v_elem.text and "Target NAV" in v_elem.text:
                                target_nav_indices.append(idx)
        
        # Ensure we have both area and line chart plots
        area_chart = plot_area.find('.//c:areaChart', 
                                   namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'})
        line_chart = plot_area.find('.//c:lineChart', 
                                   namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'})
        
        if area_chart is None or line_chart is None:
            print("Warning: Combo chart missing area or line plot")
            return
        
        # Move series to appropriate plot types
        area_series = list(area_chart.findall('.//c:ser', 
                                             namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'}))
        line_series = list(line_chart.findall('.//c:ser', 
                                             namespaces={'c': 'http://schemas.openxmlformats.org/drawingml/2006/chart'}))
        
        # Clear existing series from both plots
        for ser in area_series:
            area_chart.remove(ser)
        for ser in line_series:
            line_chart.remove(ser)
        
        # Redistribute series based on type
        for idx, ser in enumerate(all_series):
            if idx in target_nav_indices:
                # This is Target NAV - should go to line chart
                line_chart.append(ser)
            else:
                # Everything else goes to area chart
                area_chart.append(ser)
        
        print(f"Redistributed series: {len(all_series) - len(target_nav_indices)} to area, {len(target_nav_indices)} to line")
        
    except Exception as e:
        print(f"Error ensuring combo chart types: {e}")


